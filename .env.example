# Stack mínima recomendada para rodar o app localmente:
# - VS Code para desenvolvimento
# - GitHub para versionamento
# - Supabase para autenticação e dados
#
# Mantém apenas os dados públicos necessários do Supabase para o frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Opcional: se você quiser manter uma URL de app local/produção.
APP_URL=http://localhost:3000
