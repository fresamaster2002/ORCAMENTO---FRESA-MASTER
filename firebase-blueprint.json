{
  "entities": {
    "AdminConfig": {
      "title": "AdminConfig",
      "description": "Allowed administrator emails for Fresa Master access",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Authorized email address"
        },
        "role": {
          "type": "string",
          "description": "Role level (admin/owner)"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp created"
        }
      },
      "required": ["email", "role"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "User ID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "Display name"
        },
        "lastLogin": {
          "type": "string",
          "description": "Last sign in timestamp"
        }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": "AdminConfig",
      "description": "Collection of authorized administrators"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile collection"
    }
  }
}
